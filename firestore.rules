rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // User profiles
    match /users/{userId} {
      allow read, write: if true;
    }

    // Bookings collection
    match /bookings/{bookingId} {
      allow read, write: if true;
    }

    // Connection test document
    match /test/{docId} {
      allow read, write: if true;
    }

    // Public catalog & CMS data (Tests, Labs, Packages, Categories, Site Settings)
    match /tests/{testId} {
      allow read, write: if true;
    }

    match /labs/{labId} {
      allow read, write: if true;
    }

    match /packages/{packageId} {
      allow read, write: if true;
    }

    match /categories/{categoryId} {
      allow read, write: if true;
    }

    match /site_settings/{docId} {
      allow read, write: if true;
    }

    match /settings/{docId} {
      allow read, write: if true;
    }
  }
}
