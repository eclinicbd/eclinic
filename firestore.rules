rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // User profiles
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    // Bookings collection
    match /bookings/{bookingId} {
      allow read: if true;
      allow create: if true;
      allow update: if isSignedIn() || request.resource.data.status is string;
      allow delete: if isSignedIn();
    }

    // Connection test document
    match /test/{docId} {
      allow read: if true;
    }

    // Public catalog data (Tests, Labs, Packages, Site Settings)
    match /tests/{testId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /labs/{labId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /packages/{packageId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /site_settings/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
    }
  }
}
